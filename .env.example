# --- Application ---
ENVIRONMENT=development            # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# --- Security (REQUIRED in production) ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=60

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/support.db

# --- LLM provider: openai | gemini | ollama | fake ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_FAST_MODEL=
LLM_TEMPERATURE=0.1
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings: openai | gemini | ollama | fake ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- RAG ---
VECTOR_STORE=chroma                # chroma | memory
CHROMA_PERSIST_DIR=./data/chroma
COLLECTION_NAME=support_kb
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.55

# --- Email (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=support@example.com

# --- Slack ---
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# --- WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- White-label branding (customer chat page + widget) ---
COMPANY_NAME=Acme Cloud
BRAND_COLOR=#2f6f5f
CHAT_GREETING=Hi! I'm the support assistant. Ask me anything about our products, orders, or billing.

# --- Bootstrap admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-change-me

